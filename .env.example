# -----------------------------------------------------------------------------
# Hono API
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Qdrant: exactly one provider is selected. No Beam <-> Modal auto-failover.
# -----------------------------------------------------------------------------
QDRANT_PROVIDER=local
QDRANT_COLLECTION=knowledge_entities_qwen3_4b_text_v21

QDRANT_LOCAL_URL=http://127.0.0.1:6333
QDRANT_LOCAL_API_KEY=

# Validated Qdrant Native Portable examples; not hard-coded application defaults.
QDRANT_BEAM_URL=https://86ceecc1-a8a1-4623-aa06-387112d104e1-6333.app.beam.cloud
QDRANT_BEAM_API_KEY=
QDRANT_MODAL_URL=https://bsmith888--qnp-qdrant-single-qdrantserver.us-east.modal.direct
QDRANT_MODAL_API_KEY=

# Generic compatibility fallback for the explicitly selected provider.
QDRANT_URL=
QDRANT_API_KEY=

QDRANT_REQUEST_TIMEOUT_MS=10000
QDRANT_RETRY_MAX_ATTEMPTS=3
QDRANT_RETRY_BASE_DELAY_MS=250
QDRANT_RETRY_MAX_DELAY_MS=2000
QDRANT_RETRY_JITTER_RATIO=0.2
QDRANT_STARTUP_MAX_ATTEMPTS=8
QDRANT_STARTUP_BASE_DELAY_MS=500
QDRANT_STARTUP_MAX_DELAY_MS=5000

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_URL=http://127.0.0.1:8001
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# Optional local/extracted model path. Identity still comes from EMBEDDING_MODEL.
# EMBEDDING_MODEL_PATH=/kaggle/input/models/dangkhoa2016/qwen-qwen3-embedding-4b/transformers/default/1
EMBEDDING_DIMENSION=2560
EMBEDDING_REQUEST_TIMEOUT_MS=120000
# Canonical Qwen transport; json remains available as an explicit compatibility override.
EMBEDDING_TRANSPORT=binary-f32
EMBEDDING_VERSION=qwen3-4b-v1
# v2.1 is the promoted canonical document representation after full-20k validation.
EMBEDDING_TEXT_VERSION=v2.1
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=100
SEARCH_DEFAULT_SCORE_THRESHOLD=0.55
# Canonical post-retrieval structured consistency verification (proven on Hard-v3).
SEARCH_CONSISTENCY_VERIFICATION_ENABLED=true
SEARCH_CONSISTENCY_CANDIDATE_MULTIPLIER=5
SEARCH_DOMAIN_ENTITY_INTENT_GATE_ENABLED=true
SEED_BATCH_SIZE=64
DATASET_VERSION=public-v1

# -----------------------------------------------------------------------------
# Optional EN -> VI translation enrichment
# none | local | openai | gemini | nvidia | groq
# Native Vietnamese from public datasets is never overwritten.
# -----------------------------------------------------------------------------
TRANSLATION_PROVIDER=none
TRANSLATION_MODEL=
TRANSLATION_URL=http://127.0.0.1:8001
TRANSLATION_VERSION=v1
TRANSLATION_CACHE_PATH=data/generated/translation-cache.jsonl
TRANSLATION_CONCURRENCY=4
TRANSLATION_TIMEOUT_MS=30000
TRANSLATION_RETRY_MAX_ATTEMPTS=3
TRANSLATION_RETRY_BASE_DELAY_MS=250
TRANSLATION_RETRY_MAX_DELAY_MS=2000
TRANSLATION_RETRY_JITTER_RATIO=0.2
TRANSLATION_KEY_STRATEGY=round-robin
TRANSLATION_KEY_COOLDOWN_MS=60000
TRANSLATION_KEY_MAX_WAIT_MS=60000

# Optional provider base URL overrides.
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Multiple keys are supported. Number gaps are allowed (KEY1, KEY3, KEY8).
# Never commit real values. Conventional *_API_KEY is also supported as fallback.
OPENAI_KEY1=
OPENAI_KEY2=
OPENAI_API_KEY=

GEMINI_KEY1=
GEMINI_KEY2=
GEMINI_API_KEY=

NVIDIA_KEY1=
NVIDIA_KEY2=
NVIDIA_API_KEY=

GROQ_KEY1=
GROQ_KEY2=
GROQ_API_KEY=

# Canonical Qwen embedding-service settings.
EMBEDDING_PROFILE=qwen3
EMBEDDING_DEVICE=cuda
EMBEDDING_DTYPE=float16
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=512

# Rollback/reference profile. Keep the validated v1 collection; do not delete it.
# To roll search back temporarily, override all four values together:
# QDRANT_COLLECTION=knowledge_entities_qwen3_4b_v1
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# EMBEDDING_DIMENSION=2560
# EMBEDDING_TEXT_VERSION=v1

# Seed/import progress tracking. 0 = auto (~1% updates).
SEED_PROGRESS_EVERY_BATCHES=0
SEED_PROGRESS_PATH=reports/seed-progress.json
SEED_PROGRESS_EVENTS_PATH=reports/seed-progress.jsonl

# -----------------------------------------------------------------------------
# Production demo lifecycle (./run.sh)
# -----------------------------------------------------------------------------
# Optional public Cloudflare Quick Tunnel. Only the Node API is exposed.
DEMO_PUBLIC=1
# Install missing npm/Python dependencies during startup.
DEMO_INSTALL_DEPS=1
# Download a local Qdrant binary if QDRANT_BIN/qdrant are unavailable.
DEMO_DOWNLOAD_QDRANT=1
QDRANT_VERSION=1.18.0
# Existing canonical collection must already contain 20,000 verified points.
EXPECTED_POINTS=20000
# Optional persistent Qdrant storage path. On Kaggle prefer /kaggle/working.
# QDRANT_STORAGE_PATH=/kaggle/working/qdrant-bilingual-search/qdrant-data
# Optional runtime/log overrides.
# DEMO_RUNTIME_DIR=/kaggle/working/qdrant-bilingual-search/runtime
# DEMO_LOG_DIR=/kaggle/working/qdrant-bilingual-search/logs
